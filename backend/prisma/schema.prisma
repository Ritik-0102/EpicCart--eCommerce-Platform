// Prisma schema file defining database models, relations, and data types
// This schema maps to PostgreSQL tables on local Docker or Neon Serverless

// Generate the JavaScript/TypeScript client library
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL database connection configured via the DATABASE_URL environment variable
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------
// EPIC-CART DATABASE MODELS
// -------------------------------------------------

// Product category table (e.g. Electronics, Clothing, Mobile)
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // One-to-many: a single category has many associated products
  products    Product[]
}

// Catalog items available for purchase
model Product {
  id                Int       @id @default(autoincrement())
  name              String                                  
  slug              String?   @unique
  sku               String?   @unique
  description       String
  price             Float
  stock             Int       @default(0)
  lowStockThreshold Int       @default(5)
  imageUrl          String?
  imagePublicId     String?
  isPublished       Boolean   @default(true)
  isFeatured        Boolean   @default(false)
  isArchived        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Many-to-one relationship to Category
  categoryId        Int
  category          Category  @relation(fields: [categoryId], references: [id])
  
  // Relations to other entities
  cartItems         CartItem[]
  wishlistItems     WishlistItem[]
  reviews           Review[]
  inventoryLogs     InventoryLog[]
}

// Registered customer and admin accounts
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // Hashed using bcrypt
  role      String   @default("USER") // "USER" or "ADMIN"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // One-to-one relations with shopping state
  cart      Cart?
  wishlist  Wishlist?
  // One-to-many relations
  orders    Order[]
  reviews   Review[]
  auditLogs AuditLog[]
}

// Persistent shopping cart (one per user)
model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @unique
  user      User       @relation(fields: [userId], references: [id])
  items     CartItem[]
}

// Line items inside a customer's shopping cart
model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int
  cart      Cart    @relation(fields: [cartId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)

  // Ensures a product can only appear once per cart; quantity is incremented instead
  @@unique([cartId, productId])
}

// Saved products list for logged-in users
model Wishlist {
  id        Int            @id @default(autoincrement())
  userId    Int            @unique
  user      User           @relation(fields: [userId], references: [id])
  items     WishlistItem[]
}

// Line items saved in a user's wishlist
model WishlistItem {
  id         Int      @id @default(autoincrement())
  wishlistId Int
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id])
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])

  // A product can only be in a user's wishlist once
  @@unique([wishlistId, productId])
}

// Promotional discount coupons
model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountValue Float
  isPercentage  Boolean
  isActive      Boolean   @default(true)
  expiryDate    DateTime?
  minPurchase   Float?
  usageLimit    Int?
  usedCount     Int       @default(0)
  orders        Order[]
}

// Customer purchase orders
model Order {
  id              Int         @id @default(autoincrement())
  userId          Int
  user            User        @relation(fields: [userId], references: [id])
  subtotal        Float
  discount        Float
  total           Float
  couponId        Int?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  status          String      @default("PENDING") // PENDING, PROCESSING, PACKED, SHIPPED, DELIVERED, CANCELLED
  shippingAddress String
  city            String
  postalCode      String
  country         String
  trackingNumber  String?
  carrier         String?
  adminNotes      String?
  createdAt       DateTime    @default(now())
  
  // Razorpay payment integration tracking IDs
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  
  // Line items purchased in this order
  items           OrderItem[]
}

// Historical snapshot of products purchased in an order
model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id])
  productId   Int
  productName String  // Snapshotted in case product name changes later
  price       Float   // Snapshotted price at time of purchase
  quantity    Int
}

// Customer product ratings and reviews
model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1 to 5 stars
  comment   String?
  isApproved Boolean @default(true)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  // A user can submit at most one review per product
  @@unique([userId, productId])
}

// Inventory change audit trail (tracks stock adjustments and sales)
model InventoryLog {
  id          Int      @id @default(autoincrement())
  productId   Int
  product     Product  @relation(fields: [productId], references: [id])
  adminId     Int?
  prevQuantity Int
  newQuantity  Int
  adjustment   Int
  reason      String   // e.g. "Restock", "Order Placed", "Manual Adjustment"
  createdAt   DateTime @default(now())
}

// Security audit log for tracking administrator actions
model AuditLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  admin       User     @relation(fields: [adminId], references: [id])
  action      String   // e.g. "CREATE_PRODUCT", "UPDATE_ORDER_STATUS"
  targetType  String   // e.g. "Product", "Order"
  targetId    String?
  metadata    String?  // JSON string storing extra event context
  createdAt   DateTime @default(now())
}

// Key-value store configuration settings (e.g. maintenance mode, announcements)
model StoreSettings {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         String   // JSON string or plain text setting value
  updatedAt     DateTime @updatedAt
}
