# This template shows the environment variables required by the Express backend.
# Real credentials should never be committed to Git. Put actual values in your local .env file.

# Port the backend server listens on (Render automatically provides its own PORT)
PORT=5000

# Environment mode: development or production
NODE_ENV=development

# PostgreSQL connection string for Prisma ORM (points to local DB or Neon cloud)
DATABASE_URL="postgresql://username:password@localhost:5432/epiccart?schema=public"

# Frontend URL allowed by CORS (e.g. Vite dev server or Vercel production URL)
FRONTEND_URL="http://localhost:5173"

# Secret key used to sign and verify JSON Web Tokens (JWT) for authentication
JWT_SECRET="your_jwt_secret_key"

# Razorpay credentials for payment initiation and HMAC-SHA256 signature verification
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# SMTP settings for sending order confirmation emails (e.g. Mailtrap in development)
EMAIL_HOST="your_email_host"
EMAIL_PORT="your_email_port"
EMAIL_USER="your_email_user"
EMAIL_PASS="your_email_pass"

# Cloudinary credentials for storing product images uploaded by the admin
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Secret passkey required to create the very first admin account at /admin/setup
ADMIN_BOOTSTRAP_SECRET="your_bootstrap_secret_here"
