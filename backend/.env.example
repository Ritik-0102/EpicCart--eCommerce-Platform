# This file acts as a template for developers to know which environment variables are required.
# DO NOT put real secrets (like database passwords) in this file, as it gets pushed to GitHub.

PORT=5000
NODE_ENV=development

# Replace with your actual PostgreSQL connection string
DATABASE_URL="postgresql://username:password@localhost:5432/epiccart?schema=public"

# Frontend URL for CORS
FRONTEND_URL="http://localhost:5173"

# Secret key used for signing JWT tokens (do not share this)
JWT_SECRET="your_jwt_secret_key"

RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

EMAIL_HOST="your_email_host"
EMAIL_PORT="your_email_port"
EMAIL_USER="your_email_user"
EMAIL_PASS="your_email_pass"

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"