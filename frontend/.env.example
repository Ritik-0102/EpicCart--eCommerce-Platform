# Frontend Environment Variables Template
# Variables starting with VITE_ are exposed to the browser by Vite during build time.

# Base URL for the Express API (local development server or Render cloud backend)
VITE_API_URL=http://localhost:5000/api

# Public Razorpay Key ID used to open the checkout payment modal in the user's browser
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id
